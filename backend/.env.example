# Application
NODE_ENV=development
PORT=5000

# PostgreSQL / PostGIS
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Auth and Storage
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-ANON-PUBLIC-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]
SUPABASE_STORAGE_BUCKET=humdum-private-documents

# Reserved for legacy/local JWT verification when applicable
JWT_SECRET=replace_with_a_long_random_secret

# Redis and BullMQ
REDIS_URL=redis://localhost:6379
MESSAGE_RATE_LIMIT_USER_MAX=30
MESSAGE_RATE_LIMIT_USER_WINDOW_SECONDS=60
MESSAGE_RATE_LIMIT_CONVERSATION_MAX=10
MESSAGE_RATE_LIMIT_CONVERSATION_WINDOW_SECONDS=10
COMPLIANCE_WORKER_CONCURRENCY=5

# Secure uploads
MAX_UPLOAD_BYTES=10485760
SIGNED_URL_TTL_SECONDS=300

# Commute routing (server-side Google Routes API key; restrict by API and server IP)
GOOGLE_ROUTES_API_KEY=[YOUR-SERVER-ROUTES-API-KEY]
ROUTE_CACHE_SECONDS=900

